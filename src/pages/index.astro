		<script>
			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				orientation: 'vertical',
				gestureOrientation: 'vertical',
				smoothWheel: true,
			});

			let isSnapping = false;
			let snapTimeout = null;

			lenis.on('scroll', ({ scroll }) => {
				if (isSnapping) return;

				const vh = window.innerHeight;
				const currentPage = Math.round(scroll / vh);
				const target = currentPage * vh;
				const dist = Math.abs(scroll - target);

				if (dist > 2) {
					clearTimeout(snapTimeout);
					snapTimeout = setTimeout(() => {
						isSnapping = true;
						lenis.scrollTo(target, { duration: 0.6, easing: (t) => 1 - Math.pow(1 - t, 4) });
						setTimeout(() => { isSnapping = false; }, 700);
					}, 80);
				}
			});

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						document.getElementById('about-content').classList.add('visible');
					}
				});
			}, { threshold: 0.5 });
			observer.observe(document.getElementById('page2'));

			function raf(time) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}
			requestAnimationFrame(raf);

			const hireBtn = document.getElementById('hire-btn');
			const hireDropdown = document.getElementById('hire-dropdown');
			hireBtn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation();
				hireBtn.classList.remove('spam-click');
				void hireBtn.offsetWidth;
				hireBtn.classList.add('spam-click');
				hireDropdown.classList.toggle('open');
			});
			hireBtn.addEventListener('transitionend', () => {
				hireBtn.classList.remove('spam-click');
			});
			document.addEventListener('click', () => {
				hireDropdown.classList.remove('open');
			});

			const starBtn = document.getElementById('star-btn');
			const starIcon = starBtn.querySelector('svg');
			starBtn.addEventListener('click', () => {
				starBtn.classList.toggle('active');
				starIcon.classList.toggle('filled');
			});

			const canvas = document.getElementById('constellation');
			const ctx = canvas.getContext('2d');
			let dots = [];
			const DOT_COUNT = 50;
			const CONNECT_DIST = 150;
			const DOT_SPEED = 0.15;

			function resizeCanvas() {
				canvas.width = canvas.offsetWidth;
				canvas.height = canvas.offsetHeight;
			}
			resizeCanvas();
			window.addEventListener('resize', resizeCanvas);

			function initDots() {
				dots = [];
				for (let i = 0; i < DOT_COUNT; i++) {
					dots.push({
						x: Math.random() * canvas.width,
						y: Math.random() * canvas.height,
						vx: (Math.random() - 0.5) * DOT_SPEED,
						vy: (Math.random() - 0.5) * DOT_SPEED,
						r: Math.random() * 1.5 + 0.5,
					});
				}
			}
			initDots();

			function drawConstellation() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				for (let i = 0; i < dots.length; i++) {
					const a = dots[i];
					a.x += a.vx;
					a.y += a.vy;
					if (a.x < 0 || a.x > canvas.width) a.vx *= -1;
					if (a.y < 0 || a.y > canvas.height) a.vy *= -1;

					ctx.beginPath();
					ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
					ctx.fillStyle = '#444';
					ctx.fill();

					for (let j = i + 1; j < dots.length; j++) {
						const b = dots[j];
						const dx = a.x - b.x;
						const dy = a.y - b.y;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist < CONNECT_DIST) {
							ctx.beginPath();
							ctx.moveTo(a.x, a.y);
							ctx.lineTo(b.x, b.y);
							ctx.strokeStyle = `rgba(68, 68, 68, ${1 - dist / CONNECT_DIST})`;
							ctx.lineWidth = 0.5;
							ctx.stroke();
						}
					}
				}
				requestAnimationFrame(drawConstellation);
			}
			drawConstellation();
		</script>
	</body>
</html>
