								<div class="project-card-top">
									<h3 class="project-name">Conseur</h3>
									<div class="project-btns">
										<a href="#" class="project-btn project-btn-view">View</a>
										<a href="https://github.com/LyeDevGit/Conseur" target="_blank" class="project-btn project-btn-code">Code</a>
									</div>
								</div>
								<p class="project-desc">Premium developer portfolio with smooth Lenis scroll, animated constellation, and dot grid ripple effects.</p>
								<div class="project-tags">
									<span class="project-tag">Astro</span>
									<span class="project-tag">JavaScript</span>
									<span class="project-tag">Canvas</span>
								</div>
							</div>
						</div>
						<div class="project-card">
							<div class="project-thumb"><div class="project-thumb-placeholder">AI</div></div>
							<div class="project-info">
								<div class="project-card-top">
									<h3 class="project-name">AI Image Classifier</h3>
									<div class="project-btns">
										<a href="#" class="project-btn project-btn-view">View</a>
										<a href="#" class="project-btn project-btn-code">Code</a>
									</div>
								</div>
								<p class="project-desc">Real-time image classification with TensorFlow. Upload images and get instant predictions with confidence scores.</p>
								<div class="project-tags">
									<span class="project-tag">Python</span>
									<span class="project-tag">TensorFlow</span>
									<span class="project-tag">Flask</span>
								</div>
							</div>
						</div>
						</div>
					</div>
				</div>

			</div>
		</div>

		<script>
			const lenis = new Lenis({
				duration: 1.2,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				orientation: 'vertical',
				gestureOrientation: 'vertical',
				smoothWheel: true,
			});

			let isSnapping = false;
			let snapTimeout = null;

			lenis.on('scroll', ({ scroll }) => {
				if (isSnapping) return;
				const vh = window.innerHeight;
				const currentPage = Math.round(scroll / vh);
				const target = currentPage * vh;
				const dist = Math.abs(scroll - target);
				if (dist > 2) {
					clearTimeout(snapTimeout);
					snapTimeout = setTimeout(() => {
						isSnapping = true;
						lenis.scrollTo(target, { duration: 0.6, easing: (t) => 1 - Math.pow(1 - t, 4) });
						setTimeout(() => { isSnapping = false; }, 700);
					}, 80);
				}
			});

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						document.getElementById('about-content').classList.add('visible');
					}
				});
			}, { threshold: 0.5 });
			observer.observe(document.getElementById('page2'));

			function raf(time) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}
			requestAnimationFrame(raf);

			const hireBtn = document.getElementById('hire-btn');
			const hireDropdown = document.getElementById('hire-dropdown');
			hireBtn.addEventListener('click', (e) => {
				e.preventDefault();
				e.stopPropagation();
				hireBtn.classList.remove('spam-click');
				void hireBtn.offsetWidth;
				hireBtn.classList.add('spam-click');
				hireDropdown.classList.toggle('open');
			});
			hireBtn.addEventListener('transitionend', () => {
				hireBtn.classList.remove('spam-click');
			});
			document.addEventListener('click', () => {
				hireDropdown.classList.remove('open');
			});

			const starBtn = document.getElementById('star-btn');
			const starSound = new Audio('/star.mp3');
			starBtn.addEventListener('click', () => {
				starSound.currentTime = 0;
				starSound.play().catch(e => console.log('Audio play blocked:', e));
			});

			const canvas = document.getElementById('constellation');
			const ctx = canvas.getContext('2d');
			let dots = [];
			const DOT_COUNT = 50;
			const CONNECT_DIST = 150;
			const DOT_SPEED = 0.15;

			function resizeCanvas() {
				canvas.width = canvas.offsetWidth;
				canvas.height = canvas.offsetHeight;
			}
			resizeCanvas();
			window.addEventListener('resize', resizeCanvas);

			function initDots() {
				dots = [];
				for (let i = 0; i < DOT_COUNT; i++) {
					dots.push({
						x: Math.random() * canvas.width,
						y: Math.random() * canvas.height,
						vx: (Math.random() - 0.5) * DOT_SPEED,
						vy: (Math.random() - 0.5) * DOT_SPEED,
						r: Math.random() * 1.5 + 0.5,
					});
				}
			}
			initDots();

			function drawConstellation() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				for (let i = 0; i < dots.length; i++) {
					const a = dots[i];
					a.x += a.vx;
					a.y += a.vy;
					if (a.x < 0 || a.x > canvas.width) a.vx *= -1;
					if (a.y < 0 || a.y > canvas.height) a.vy *= -1;

					ctx.beginPath();
					ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
					ctx.fillStyle = '#444';
					ctx.fill();

					for (let j = i + 1; j < dots.length; j++) {
						const b = dots[j];
						const dx = a.x - b.x;
						const dy = a.y - b.y;
						const dist = Math.sqrt(dx * dx + dy * dy);
						if (dist < CONNECT_DIST) {
							ctx.beginPath();
							ctx.moveTo(a.x, a.y);
							ctx.lineTo(b.x, b.y);
							ctx.strokeStyle = `rgba(68, 68, 68, ${1 - dist / CONNECT_DIST})`;
							ctx.lineWidth = 0.5;
							ctx.stroke();
						}
					}
				}
				requestAnimationFrame(drawConstellation);
			}
			drawConstellation();

			// Keyboard script
			const keys = document.querySelectorAll('.key');
			
			function getRandomInt(min, max) {
				let minInt = Math.ceil(min);
				let maxInt = Math.floor(max);
				return Math.floor(Math.random() * (maxInt - minInt) + minInt);
			}
			
			const themes = {
				silver: [
					{ r: 255, g: 255, b: 255 }, // Pure white
					{ r: 220, g: 220, b: 225 }, // Light silver
					{ r: 190, g: 190, b: 195 }, // Mid silver
					{ r: 170, g: 170, b: 175 }, // Dark silver
					{ r: 240, g: 240, b: 245 }, // Off-white
					{ r: 200, g: 205, b: 210 }  // Cool silver
				]
			};
			
			const setRandomKeyColor = (key, color) => {
				const { r, g, b } = color;
				key.style.setProperty('--color', `rgb(${r},${g},${b})`);
				key.style.setProperty('--box-shadow', `rgba(${r},${g},${b},0.6)`);
				key.style.setProperty('--box-shadow-inner', `rgba(${r},${g},${b},0.15)`);
				key.style.setProperty('--text-shadow', `rgba(${r},${g},${b},0.3)`);
			};
			
			const setTheme = (name) => {
				const theme = themes[name];
				keys.forEach((key) => setRandomKeyColor(key, theme[getRandomInt(0, theme.length)]));
			};
			
			// Initialize and constantly animate the silver shimmer
			setTheme('silver');
			setInterval(() => {
				setTheme('silver');
			}, 2000); // Shifts colors every 2 seconds

			// Daily quote
			const quoteEl = document.getElementById('quote-text');
			const cached = JSON.parse(localStorage.getItem('dailyQuote') || 'null');
			const today = new Date().toDateString();
			if (cached && cached.date === today) {
				quoteEl.textContent = `"${cached.quote}"`;
			} else {
				fetch('https://api.quotable.io/random')
					.then(r => r.json())
					.then(data => {
						quoteEl.textContent = `"${data.content}"`;
						localStorage.setItem('dailyQuote', JSON.stringify({ date: today, quote: data.content }));
					})
					.catch(() => {
						quoteEl.textContent = '"First, solve the problem. Then, write the code."';
					});
			}

			// Ad carousel
			const adSlides = document.querySelectorAll('.ad-slide');
			const adDots = document.querySelectorAll('.ad-dot');
			let currentAd = 0;
			if (adSlides.length > 0) {
				setInterval(() => {
					adSlides[currentAd].classList.remove('active');
					adDots[currentAd].classList.remove('active');
					currentAd = (currentAd + 1) % adSlides.length;
					adSlides[currentAd].classList.add('active');
					adDots[currentAd].classList.add('active');
				}, 3000);
			}

		</script>
	</body>
</html>
